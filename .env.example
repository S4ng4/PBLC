# ==============================================================================
# PLCB Invoice Processor — Configurazione Automazione Email (IMAP + SMTP)
# ==============================================================================
# Copia questo file in `.env` e compila i tuoi valori.
# NON fare mai commit del file `.env` con le tue password!

# --- 1. CASELLA PREDEFINITA DI RICEZIONE (IMAP) -------------------------------
# Consigliato: usa una casella dedicata alle fatture PLCB (es. plcb.gca@gmail.com)
# oppure la tua Gmail filtrando tramite IMAP_TO_FILTER (es. tuamail+plcb@gmail.com).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=fatture.plcb@gmail.com
# Su Gmail genera una "Password per le app" (16 caratteri) dalle impostazioni Account Google -> Sicurezza -> Verifica in due passaggi.
IMAP_PASSWORD=xxxx xxxx xxxx xxxx
IMAP_MAILBOX=INBOX

# Cartelle/etichette Gmail in cui spostare automaticamente le email dopo l'elaborazione
IMAP_PROCESSED_FOLDER=PLCB/Processed
IMAP_ERROR_FOLDER=PLCB/Error

# --- Filtri opzionali (lascia vuoti se usi una casella dedicata) --------------
# Se usi un alias tipo tuamail+plcb@gmail.com sulla tua casella principale, impostalo qui:
IMAP_TO_FILTER=
# Lista opzionale di mittenti o domini consentiti separati da virgola (es. @pa.gov,tuamail@gmail.com):
IMAP_ALLOWED_SENDERS=
# Filtro opzionale su una parola chiave nell'oggetto (lascia vuoto per accettare qualsiasi oggetto):
IMAP_SUBJECT_CONTAINS=

# --- 2. INVIO EMAIL (SMTP) ----------------------------------------------------
# Se lasci vuoti SMTP_USER / SMTP_PASSWORD / SMTP_FROM vengono riutilizzati i dati IMAP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- 3. DESTINATARI PREDISPOSTI (separati da virgola) -------------------------
# Gruppo A — SOLO PDF MarginEdgeFinal ({Invoice}_fattura_GCA.pdf):
# Ideale per l'indirizzo di import automatico di MarginEdge.
PDF_ONLY_RECIPIENTS=invoices@marginedge.com

# Gruppo B — REPORT COMPLETO (PDF MarginEdgeFinal + Excel + opz. PDF originale PLCB):
# Ideale per contabilità, amministrazione o copia personale.
FULL_RECIPIENTS=amministrazione@grancaffelaquila.com

# Gruppo C — ALERT ERRORI / DISCREPANZE (scarto > $0.01 o PDF non leggibile):
# Se la verifica fallisce, l'invio ai Gruppi A e B viene BLOCCATO e viene avvisato solo questo indirizzo.
# Se vuoto, usa IMAP_USER.
ALERT_RECIPIENTS=admin@grancaffelaquila.com

# --- 4. OPZIONI CONTENUTI E ARCHIVIO ------------------------------------------
# Allegare anche il PDF originale PLCB nelle email del Gruppo B (FULL_RECIPIENTS)?
INCLUDE_ORIGINAL_PDF_IN_FULL=true
# Inviare un alert se arriva un PDF che non è una fattura PLCB riconosciuta?
ALERT_ON_UNRECOGNIZED_PDF=true

# Template oggetto email personalizzabili (placeholder disponibili:
# {invoice_number}, {invoice_type}, {invoice_date}, {order_number}, {customer_name}, {total_net}, {sum_p}, {n_items}, {units})
PDF_ONLY_SUBJECT_TEMPLATE=PLCB Invoice {invoice_number} ({invoice_type} - {invoice_date})
FULL_SUBJECT_TEMPLATE=[GCA] Fattura PLCB {invoice_number} — MarginEdge (${total_net:.2f})
ALERT_SUBJECT_TEMPLATE=[ATTENZIONE PLCB] Verifica fallita / Errore — {invoice_number}

# Cartella locale opzionale in cui salvare una copia archivio (lascia vuoto su GitHub Actions)
ARCHIVE_DIR=
# Intervallo in secondi per la modalità locale `--watch`
POLL_INTERVAL_SECONDS=60
# Metti true per fare prove senza inviare email né spostare messaggi
DRY_RUN=false
